# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 秘密を含む env のみ除外（.env.example はコミットする）
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
e2e/.env.e2e

# playwright
/test-results/
/playwright-report/
/e2e-report/
/blob-report/
/playwright/.cache/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ローカル調査・画面キャプチャ・GASプロジェクト設定はコミットしない
scratch_*
.clasp.json
