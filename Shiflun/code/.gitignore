# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Capacitor (iOS/Android) — ビルド成果物・マシン固有ファイルのみ除外。
# android/ ios/ 配下のプロジェクト本体（設定・アイコン等）はコミット対象。
android/app/build/
android/.gradle/
android/local.properties
android/**/build/
ios/App/Pods/
ios/App/build/
ios/App/DerivedData/
ios/**/xcuserdata/
ios/**/*.xcuserstate

# Claude Code ローカル設定（個人用、共有しない）
.claude/settings.local.json

# Supabase CLI のローカルキャッシュ
supabase/.temp/

# アプリ用のオフライン画面（npm run cap:sync が resources/offline.template.html から作る）
public/offline.html
